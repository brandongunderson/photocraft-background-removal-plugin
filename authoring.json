{
  "formatVersion": 1,
  "descriptor": {
    "apiVersion": 2,
    "id": "org.photocraft.background-removal",
    "name": "Background Removal",
    "version": "1.2.0",
    "author": "Brandon Gunderson",
    "description": "Remove the background with local IMG.LY AI. Keep the subject, isolate the background, or create a mask. Preview at the original size, then apply to a new image or layer.",
    "permissions": {
      "documentRead": true,
      "commands": [
        "plugin.processImage"
      ]
    },
    "panel": {
      "preview": true,
      "fields": [
        {
          "id": "model",
          "label": "AI model",
          "type": "choice",
          "options": [
            "Standard · full precision",
            "Compact · half precision",
            "Small · quantized"
          ],
          "default": "Compact · half precision"
        },
        {
          "id": "output",
          "label": "Result",
          "type": "choice",
          "options": [
            "Keep subject",
            "Keep background",
            "Subject mask"
          ],
          "default": "Keep subject"
        }
      ],
      "buttons": [
        {
          "id": "remove",
          "label": "Create result"
        }
      ]
    },
    "capabilities": {
      "required": [
        {
          "id": "host.commands.invoke",
          "minVersion": 1
        }
      ],
      "optional": []
    }
  },
  "package": {
    "packageVersion": 2,
    "module": "plugin.pcext",
    "native": {
      "service": "plugin.processImage",
      "platform": "windows-x86_64",
      "entry": "photocraft-background-worker.exe"
    }
  }
}
